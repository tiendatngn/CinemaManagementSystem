<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
    
    <display-name>MovieManagement</display-name>

    <!-- 1. Servlet Quản lý phim -->
    <servlet>
        <servlet-name>MovieServlet9</servlet-name>
        <servlet-class>controller.MovieServlet9</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MovieServlet9</servlet-name>
        <url-pattern>/movie</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>MovieServlet9</servlet-name>
        <url-pattern>/movies</url-pattern>
    </servlet-mapping>

    <!-- 2. Servlet Thêm phim mới -->
    <servlet>
        <servlet-name>AddMovieServlet9</servlet-name>
        <servlet-class>controller.AddMovieServlet9</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddMovieServlet9</servlet-name>
        <url-pattern>/addMovie</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AddMovieServlet9</servlet-name>
        <url-pattern>/doAddMovie</url-pattern>
    </servlet-mapping>

    <!-- 3. Servlet Đăng nhập -->
    <servlet>
        <servlet-name>LoginServlet9</servlet-name>
        <servlet-class>controller.LoginServlet9</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet9</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LoginServlet9</servlet-name>
        <url-pattern>/doLogin</url-pattern>
    </servlet-mapping>

    <!-- 4. Servlet Chọn suất chiếu -->
    <servlet>
        <servlet-name>SelectShowtimesServlet9</servlet-name>
        <servlet-class>controller.SelectShowtimesServlet9</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SelectShowtimesServlet9</servlet-name>
        <url-pattern>/selectShowtime</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SelectShowtimesServlet9</servlet-name>
        <url-pattern>/showtimes</url-pattern>
    </servlet-mapping>

    <!-- 5. Servlet Chọn ghế -->
    <servlet>
        <servlet-name>SelectSeatServlet9</servlet-name>
        <servlet-class>controller.SelectSeatServlet9</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SelectSeatServlet9</servlet-name>
        <url-pattern>/selectSeat</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SelectSeatServlet9</servlet-name>
        <url-pattern>/seatMap</url-pattern>
    </servlet-mapping>

    <!-- 6. Servlet Thanh toán -->
    <servlet>
        <servlet-name>PaymentServlet9</servlet-name>
        <servlet-class>controller.PaymentServlet9</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentServlet9</servlet-name>
        <url-pattern>/payment</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PaymentServlet9</servlet-name>
        <url-pattern>/doPayment</url-pattern>
    </servlet-mapping>
    
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
